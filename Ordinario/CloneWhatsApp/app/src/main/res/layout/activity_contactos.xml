<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#080B19">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DIRECTORIO DE USUARIOS"
        android:textColor="#00F5FF"
        android:textSize="21sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"/>

    <EditText
        android:id="@+id/etBuscarContacto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Buscar usuario..."
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="@drawable/bg_neon_input"
        android:padding="12dp"
        android:singleLine="true"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContactos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/tvSinContactos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NO SE ENCONTRARON USUARIOS"
        android:textColor="#FF38E8"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnVolverContactos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VOLVER"
        android:textColor="#080B19"
        android:background="@drawable/bg_neon_button"/>

</LinearLayout>
