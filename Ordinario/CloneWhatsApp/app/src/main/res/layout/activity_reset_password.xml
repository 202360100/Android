<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◆  ◆  ◆"
            android:textColor="#FF38E8"
            android:textSize="18sp"
            android:layout_marginTop="35dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLONE"
            android:textColor="#00F5FF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHATSAPP"
            android:textColor="#FF38E8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/bg_neon_panel">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECUPERAR ACCESO"
                android:textColor="#00F5FF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduce tu nueva contraseña."
                android:textColor="#AAB2D5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NUEVA CONTRASEÑA"
                android:textColor="#FF38E8"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNuevaPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_neon_input"
                android:hint="Nueva contraseña"
                android:textColor="#FFFFFF"
                android:textColorHint="#68708F"
                android:padding="12dp"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONFIRMAR CONTRASEÑA"
                android:textColor="#FF38E8"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_neon_input"
                android:hint="Repite la contraseña"
                android:textColor="#FFFFFF"
                android:textColorHint="#68708F"
                android:padding="12dp"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnCambiarPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_neon_button"
                android:text="ACTUALIZAR CONTRASEÑA"
                android:textColor="#080B19"
                android:textStyle="bold"
                android:textSize="13sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM RECOVERY // VERSION 1.0"
            android:textColor="#00F5FF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="25dp" />

    </LinearLayout>
</ScrollView>
