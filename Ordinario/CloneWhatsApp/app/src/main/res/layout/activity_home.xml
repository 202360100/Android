<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B19">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="18dp"
        android:background="#10152B">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLONE"
                android:textColor="#00F5FF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHATSAPP // NETWORK"
                android:textColor="#FF38E8"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFotoHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:contentDescription="Foto de perfil"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Título de sección -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="/// CENTRO DE MENSAJES"
        android:textColor="#00F5FF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:padding="18dp" />

    <!-- Pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/tabChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CHATS"
            android:textColor="#00F5FF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/bg_neon_input" />

        <TextView
            android:id="@+id/tabEstados"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ESTADOS"
            android:textColor="#8A94B8"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tabLlamadas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="LLAMADAS"
            android:textColor="#8A94B8"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Contenido -->


    <!-- Contenido -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/tvSinConversaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="12dp"
            android:text="Todavía no tienes conversaciones"
            android:textColor="#888888"
            android:textSize="15sp"
            android:visibility="gone"/>

    </FrameLayout>



    <!-- Barra inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="#10152B">

        <TextView
            android:id="@+id/btnCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="CERRAR SESIÓN"
            android:textColor="#FF38E8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_neon_input" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnNuevoChat"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#080B19"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/bg_neon_button" />

    </LinearLayout>

</LinearLayout>
