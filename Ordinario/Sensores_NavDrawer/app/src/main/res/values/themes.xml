<resources>
    <style name="Base.Theme.Sensores_NavDrawer"
        parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorSecondary">#03A9F4</item>
        <item name="android:statusBarColor">#0D47A1</item>
        <item name="android:navigationBarColor">#0D47A1</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Sensores_NavDrawer"
        parent="Base.Theme.Sensores_NavDrawer" />

    <style name="Theme.Sensores_navdrawer.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#0D47A1</item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_sensores
        </item>

        <item name="windowSplashScreenAnimationDuration">500</item>

        <item name="postSplashScreenTheme">
            @style/Theme.Sensores_NavDrawer
        </item>

    </style>
</resources>