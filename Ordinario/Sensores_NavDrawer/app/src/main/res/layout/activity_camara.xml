<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FA">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/header_camara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_volver_camara"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:padding="16dp"
                app:tint="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Cámara"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Captura de fotografías"
                android:textColor="#1565C0"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Utiliza la cámara de tu dispositivo para visualizar y capturar imágenes."
                android:textColor="#555555"
                android:textSize="15sp"/>

            <!-- Vista previa de cámara -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/preview_camara"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Botón tomar fotografía -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capturar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tomar fotografía"
                android:enabled="false"
                app:icon="@android:drawable/ic_menu_camera"
                app:cornerRadius="12dp"/>

            <TextView
                android:id="@+id/txt_estado_camara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:background="#E3F2FD"
                android:text="Esperando autorización de cámara..."
                android:textColor="#1565C0"
                android:gravity="center"
                android:textSize="15sp"/>

            <!-- Fotografía capturada -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Última fotografía"
                android:textColor="#1565C0"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/img_captura"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:scaleType="centerCrop"
                android:background="#DDDDDD"
                android:contentDescription="Última fotografía capturada"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>