<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="@color/terminal_black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW PASSWORD"
        android:textColor="@color/terminal_green"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="NEW PASSWORD"
        android:inputType="textPassword"
        android:textColor="@color/terminal_green"
        android:textColorHint="@color/terminal_gray"
        android:backgroundTint="@color/terminal_green"/>

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="CONFIRM PASSWORD"
        android:inputType="textPassword"
        android:textColor="@color/terminal_green"
        android:textColorHint="@color/terminal_gray"
        android:backgroundTint="@color/terminal_green"
        android:layout_marginTop="15dp"/>

    <Button
        android:id="@+id/btnUpdatePassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="[ UPDATE PASSWORD ]"
        android:textColor="@color/terminal_black"
        android:backgroundTint="@color/terminal_green"
        android:layout_marginTop="25dp"/>

    <TextView
        android:id="@+id/tvNewPasswordStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WAITING FOR INPUT..."
        android:textColor="@color/terminal_green"
        android:gravity="center"
        android:padding="20dp"/>

</LinearLayout>
